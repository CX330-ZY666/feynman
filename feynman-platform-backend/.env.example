# Server
PORT=3000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated)
CORS_ORIGINS=https://your-frontend.vercel.app,https://www.your-domain.com

# Baidu AI
BAIDU_APP_ID=your_baidu_app_id
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key
QIANFAN_ACCESS_KEY=your_qianfan_access_key
QIANFAN_SECRET_KEY=your_qianfan_secret_key
QIANFAN_IAM_ACCESS_KEY=your_qianfan_iam_access_key
QIANFAN_IAM_SECRET_KEY=your_qianfan_iam_secret_key

# Whisper (optional)
ENABLE_WHISPER=false
WHISPER_API_URL=http://localhost:5001
WHISPER_MODEL=base

# Other
USE_MOCK_AI=false
HF_ENDPOINT=https://hf-mirror.com
DEEPSEEK_API_KEY=your_deepseek_api_key
